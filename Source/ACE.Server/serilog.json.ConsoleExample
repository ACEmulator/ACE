// This config file shows you how to refine your console output.
// In this example, the following takes place:
//   All Information, Warning, Error and Fatal messages go to the console
//   Any Debug message containing [CORPSE] or [LOOT] also goes to the console
//   Any Debug message from ACE.Server.Managers.HouseManager also goes to the console
//
// The second Console entry is a sub-logger ("Logger") with its own filter.
// Filters are Serilog.Expressions: @l is the level, @m the rendered message, SourceContext the logger name.
// IsMatch is a case-sensitive regular expression match; add "ci" after a comparison to ignore case.
{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {Level:u3}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@l in ['Verbose', 'Debug'] and (IsMatch(@m, '\\[(CORPSE|LOOT)\\]') or StartsWith(SourceContext, 'ACE.Server.Managers.HouseManager'))"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "Console",
                "Args": {
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {Level:u3}: {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
