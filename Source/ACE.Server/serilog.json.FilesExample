// This config file shows you how to separate your log data into more organized files.
// You might want to do this to make browsing files easier.
//
// In this example, the following files are created:
//   ACE_Log.txt          - Contains all log messages
//   ACE_Log-INFO.txt     - Contains Information, Warning, Error and Fatal messages
//   ACE_Log-WARN.txt     - Contains Warning, Error and Fatal messages
//   ACE_Log-CORPSE.txt   - Contains all log messages that contain [CORPSE]
//   ACE_Log-DATABASE.txt - Contains all log messages that contain [DATABASE]
//
// Filters are Serilog.Expressions: @l is the level, @m the rendered message, SourceContext the logger name.
// IsMatch is a case-sensitive regular expression match. For a case-insensitive match use (?i), e.g. '(?i)corpse'.
//
// Everything is wrapped in "Async", so filtering and writing happen on a background thread, not the thread that logged.
// Keep it that way: a filter on @m has to build the message text for every message it checks.
{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Async", "Serilog.Sinks.File", "Serilog.Expressions", "ACE.Server" ],
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "Enrich": [ "WithThread" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "ACE_Log.txt",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 20971520,
                "retainedFileCountLimit": 11,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} [{Thread}] {Level:u3} ({SourceContext}) {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "ACE_Log-INFO.txt",
                "restrictedToMinimumLevel": "Information",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 20971520,
                "retainedFileCountLimit": 11,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} [{Thread}] {Level:u3} ({SourceContext}) {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "ACE_Log-WARN.txt",
                "restrictedToMinimumLevel": "Warning",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 20971520,
                "retainedFileCountLimit": 11,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} [{Thread}] {Level:u3} ({SourceContext}) {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "Filter": [
                    {
                      "Name": "ByIncludingOnly",
                      "Args": {
                        "expression": "IsMatch(@m, '\\[CORPSE\\]')"
                      }
                    }
                  ],
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "ACE_Log-CORPSE.txt",
                        "rollOnFileSizeLimit": true,
                        "fileSizeLimitBytes": 20971520,
                        "retainedFileCountLimit": 11,
                        "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} [{Thread}] {Level:u3} ({SourceContext}) {Message:lj}{NewLine}{Exception}"
                      }
                    }
                  ]
                }
              }
            },
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "Filter": [
                    {
                      "Name": "ByIncludingOnly",
                      "Args": {
                        "expression": "IsMatch(@m, '\\[DATABASE\\]')"
                      }
                    }
                  ],
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "ACE_Log-DATABASE.txt",
                        "rollOnFileSizeLimit": true,
                        "fileSizeLimitBytes": 20971520,
                        "retainedFileCountLimit": 11,
                        "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} [{Thread}] {Level:u3} ({SourceContext}) {Message:lj}{NewLine}{Exception}"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
